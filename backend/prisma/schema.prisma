generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  reply     String?
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
