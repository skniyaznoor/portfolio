# Resend API key used by /api/contact (https://resend.com/api-keys). A "sending access" key is enough.
# Don't wrap the value in quotes.
RESEND_API_KEY=
# Where portfolio messages are delivered. Without a verified domain, Resend only delivers to the
# email address that owns the Resend account.
CONTACT_TO_EMAIL=niyazunveiled@gmail.com
# Sender. Keep onboarding@resend.dev until you verify a domain at resend.com/domains.
CONTACT_FROM_EMAIL=Niyazion <onboarding@resend.dev>
# Public site URL, used for Open Graph metadata
NEXT_PUBLIC_APP_URL=https://your-domain.com
